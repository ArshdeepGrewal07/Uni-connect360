# Local: copy this file to .dev.vars. Hosted values are managed by Sites.
# npm start explicitly enables local demo accounts unless overridden here.
DEMO_MODE=true
# Keep false unless intentional scripted replies are desired.
SIMULATE_DEMO_REPLIES=false
# For real OTP delivery set DEMO_MODE=false and configure these:
# OTP_DELIVERY_URL=https://your-authorised-provider.example/send
# OTP_DELIVERY_TOKEN=private-provider-token
# OTP_SIGNING_SECRET=stable-random-secret-at-least-32-characters
# Optional genuine campus sensor feed:
# IOT_API_URL=https://your-authorised-campus-adapter.example/telemetry
# IOT_API_TOKEN=private-adapter-token
# DB and BUCKET are runtime bindings, not database URLs or client-side secrets.
